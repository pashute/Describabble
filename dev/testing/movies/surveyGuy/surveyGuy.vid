# surveyGuy.vid v0.1.61
# Standardized YAML format for Describabble stick figure animation
# Machine-readable and human-friendly structure

movie:
  name: "The Survey Guy"
  version: "0.2.45b"
  created: "2025-09-14"
  description: "A dark comedy stick figure short film about a phone survey guy contemplating a bridge jump"
  license: "Unlicense (Free and Open Source)"
  creator: "Moussa Yashir"
  production: "Describabble with Anthropic Claude and Gemini Flash lite"

specs:
  totalDuration: 65.0
  fps: 60
  canvasWidth: 960
  canvasHeight: 540
  aspectRatio: "16:9"

characters:
  - id: "char1"
    name: "Survey Guy"
    aka: "SG"
    headSize: "LARGE"
    headShape: "oval"
  - id: "char2"
    name: "Worried Man"
    aka: "WM"
    role: "support"
    importance: 1
    headSize: "TINY"
    headShape: "square"
    headVariants: "none"
    attire:
      shirt: "casual"
      tie: "none"
    voice:
      gender: "male"
      age: "24"
    pov: "from-above"
    size: "triple"
    renderStyle:
      lineWidth: 6
      color: "#FFFFFF"
      headDiameter: 120
      footAngles: "sharp-angle"
      eyesMouth: "upper-head"
      neck: false
      body: false
      armLength: 45
      armAnimation: "flailing-asymmetric"
    animation:
      arms: "asymmetric"
      wavePattern: "diagonal-axis"
    position: "standing-on-road"
    positionDetail: "On road below bridge. Position: Almost under bridge to right (E6 Left)"

  - id: "char3"
    name: "Narrator"
    aka: "NARRATOR"
    role: "narrator"
    importance: 0
    backstage: true
    headSize: "NONE"
    voice:
      gender: "male"
      age: "50s"
      quality: "deep, resonant, authoritative"
    description: "Off-screen narrator for sound effects and scene descriptions"

locations:
  - id: "loc_bridge_below"
    name: "River Below Bridge"
    camera:
      position: "riverside-ground"
      angle: "looking-up"
      target: "bridge-and-character"
    elements:
      - "suspension-bridge"
      - "fence-railing"
      - "suspender-cables"
    lighting: "daytime-overcast"
    description: "Looking up at bridge from riverside, seeing character climbing on fence"

  - id: "loc_bridge_top"
    name: "Bridge Top View"
    camera:
      position: "bridge-level"
      angle: "looking-down"
      target: "riverside"
    elements:
      - "suspension-bridge"
      - "river"
      - "distant-character"
    lighting: "daytime-overcast"
    description: "Standing on bridge looking down at riverside and distant character"

scenes:
  - id: "scene1"
    number: 1
    name: "EXT. SUSPENSION BRIDGE - DAY"
    duration:
      start: 0.0
      end: 65.0
    location: "loc_bridge"
    shots:
      - id: "shot1"
        number: 1
        name: "credits"
        timeRange:
          start: 0.0
          end: 8.0
        camera:
          pov: "credits-screen"
          angle: "centered"
        graphics:
          - id: "bridge-icon-credits"
            type: "bridge-small"
            position: "left-of-text2"
            description: "Bridge image (bridgeside.jpeg) left 1/3 of screen, scaled without cropping. Text2 (cast/credits) in separate HTML div on right 2/3. No overlap. Text2 rendered large and bold."
            layout:
              imageWidth: "33%"
              textWidth: "67%"
              textFormat: "bold-html-overlay"
        characters: []
        dialogue: []
        billboard:
          text1:
            align: "left"
            lines: 10
            emptyRowMode: "keep"
            content: |
              The Survey Guy



              TTTTT H   H EEEEE     SSSs   U   U  RRRr   V     V EEEEE Y   Y     GGGGg  U   U  Y   Y
                T   H   H E     :: S       U   U  R   R  V     V E      Y Y   :: G      U   U   Y Y
                T   HHHHH EEEEE     SSS    U   U  RRRR    V   V  EEE     Y       G gGG  U   U    Y
                T   H   H E     ::      S  U   U  R  R     V V   E       Y    :: G   G  U   U    Y
                T   H   H EEEEE     Ssss   UUUUU  R    R    V    EEEEE   Y        GGG    UuU     Y
          text2:
            align: "center"
            lines: 9
            emptyRowMode: "keep"
            content: |

              Starring:
              Harold Purpleman as The Survey Guy
              Herman Herstick as The Worried Man

              Created and Edited by Moussa Yashir
              Produced by Describabble

              Released Unlicensed Sept 2026
        
        narration:
          - speaker: "char3"
            voice: "voice3"
            text: "The Survey Guy - a generated movie...  "
            startTime: 0.0
            endTime: 1.0
            delivery: "title-reading"
            caption: "The Survey Guy - a generated movie...  "
          - speaker: "char3"
            voice: "voice3"
            text: "(Heavy traffic heard, honking, radio blaring, unclear music)"
            startTime: 2.0
            endTime: 3.0
            delivery: "sound-effect"
            caption: "(Heavy traffic heard, honking, radio blaring, unclear music)"

      - id: "shot2"
        number: 2
        name: "climbing"
        timeRange:
          start: 8.0
          end: 14.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
        environment:
          description: "Wide landscape view from camera position on left bank. Stream flows from foreground toward distant lake. Four non-symmetric distant hills above bridge, oval lake behind them spanning full width extending past right edge. Stream bed as light blue trapeze with slightly curved non-symmetric sides. Bridge road spans middle two quarters of screen width, with two tall towers anchoring into land on both sides of stream. Suspension rope concave arc above road, six vertical cables connecting rope to road, triangular trusses on road with red rail-top. Path on left bank of stream with subtle dashed side lines, passes under left side of bridge. Hills slope from bridge road down to stream on both sides."
        sky:
          color: "#87CEEB"
          cloud:
            position: "far-left"
            size: "small"
            color: "white"
        characters:
          - id: "char1"
            location: "new"
            position: "fence-climbing"
            size: "half"
            emotion: "distressed"
            posture: "climbing"
            details: "panting, hesitant motion"
            renderStyle:
              fillColor: "#FFE4B5"
              description: "SG face has own fill color, not sky color"
            animation:
              bodyLean: "toggle"
              leanAngles:
                - direction: "left"
                  degrees: 15
                - direction: "right"
                  degrees: 15
              leanCycle: 0.5
              mouthAnimation: "o-shape-to-flat"
        movement:
          character: "char1"
          type: "climbing"
          description: "climbing up fence from bridge, hands gripping, legs bent, body toggling left-right lean, starts with feet on bridge floor, ends hanging on fence"
          keyframes:
            - time: 0.0
              position: "standing-on-bridge-floor"
              description: "feet on bridge floor"
            - time: 6.0
              position: "hanging-on-fence"
              description: "reached end of climb, hanging on fence"
        animationEvents:
          climbEnd:
            time: 5.0
            description: "At climb end, activate clamp animation"
            clampAnimation:
              armSide: "alternate"
              description: "Lower arm clamping fence rail - left arm 130 degrees or right arm 150 degrees"
        dialogue: []
        captions:
          position: "bottom"
          text: "@narration"
        narration:
          - speaker: "char1"
            voice: "voice1"
            text: "(man climbs, panting, clearly distressed)"
            startTime: 8.0
            endTime: 14.0
            delivery: "description"
            caption: "(man climbs, panting, clearly distressed)"

      - id: "shot3"
        number: 3
        name: "WM1_Wife"
        timeRange:
          start: 14.0
          end: 20.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road below bridge, almost under it, looking upward. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char2"
            characterRef: "@characters/WM"
            emotion: "worried"
            expression: "eyebrows-up"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Hey! Think about your wife! Think about your children!"
            startTime: 14.0
            endTime: 19.0
            delivery: "shouting-urgent"
            tone: "emotional"
            voiceCue: "(shout heard)"
        captions:
          position: "bottom"
          text: |
            (shouts) Think about your wife!
            Think about your children!

      - id: "shot4"
        number: 4
        name: "SG1_NoWife"
        timeRange:
          start: 20.0
          end: 25.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
          zoom: "zoomed-out"
          description: "Zoomed out to show more of bridge structure"
        sky:
          color: "#87CEEB"
          cloud:
            position: "mid-left"
            size: "small"
            color: "white"
        characters:
          - id: "char1"
            location: "climbed"
            position: "hanging-on-fence"
            positionDetail: "1 head down from fence top"
            emotion: "defensive"
            posture: "standing"
            expression: "eyebrows-down"
            size: "slightly-smaller-than-shot2"
            description: "SG appears slightly smaller than in shot 2"
            renderStyle:
              fillColor: "#FFE4B5"
              mouthAnimation: "o-shape-to-flat"
            climbedPosition:
              bodyLean: "right"
              leanDegrees: 30
              extended: "out"
              legBent: "left"
              clamping: "left"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "I don't have a wife! I don't have kids!"
            startTime: 19.0
            endTime: 24.0
            delivery: "shouting-defensive"
            tone: "emphatic"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          yOffset: 50
          fontSize: "small"
          lineHeight: 16
          description: "Thinner single-line caption bar, positioned at y=50"
          text: "(shouts back) I don't have a wife! I don't have kids!"

      - id: "shot5"
        number: 5
        name: "WM2_Parents"
        timeRange:
          start: 25.0
          end: 29.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char2"
            characterRef: "@characters/WM"
            emotion: "desperate"
            expression: "eyebrows-down"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Think about your parents!"
            startTime: 24.0
            endTime: 28.0
            delivery: "shouting-desperate"
            tone: "escalating"
            voiceCue: "(shouts)"
        captions:
          position: "bottom"
          text: "(shouts) Think about your parents!"

      - id: "shot6"
        number: 6
        name: "SG2_NoParents"
        timeRange:
          start: 29.0
          end: 32.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
          zoom: "zoomed-out"
          description: "Zoomed out to show more of bridge structure"
        sky:
          color: "#87CEEB"
          cloud:
            position: "mid-right"
            size: "small"
            color: "white"
        characters:
          - id: "char1"
            location: "climbed"
            position: "hanging-on-fence"
            positionDetail: "sitting on fence rail (good)"
            emotion: "anguished"
            posture: "standing"
            expression: "mouth-open"
            size: "slightly-smaller-than-shot2"
            description: "SG appears slightly smaller than in shot 2"
            renderStyle:
              fillColor: "#FFE4B5"
              mouthAnimation: "o-shape-to-flat"
            climbedPosition:
              bodyLean: "left"
              leanDegrees: 30
              extended: "out"
              legBent: "right"
              clamping: "right"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "I don't have parents!"
            startTime: 28.0
            endTime: 31.0
            delivery: "shouting-raw"
            tone: "emotional"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          yOffset: 50
          fontSize: "small"
          lineHeight: 16
          description: "Thinner single-line caption bar, positioned at y=50"
          text: "(shouts back) I don't have parents!"

      - id: "shot7"
        number: 7
        name: "WM3_Future"
        timeRange:
          start: 32.0
          end: 36.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char2"
            characterRef: "@characters/WM"
            emotion: "desperate"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Think about your future!"
            startTime: 31.0
            endTime: 35.0
            delivery: "shouting-peak"
            tone: "maximum-intensity"
            voiceCue: "(shouts)"
        captions:
          position: "bottom"
          text: "(shouts) Think about your future!"

      - id: "shot8"
        number: 8
        name: "SG3_NoFuture"
        timeRange:
          start: 36.0
          end: 46.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
          zoom: "zoomed-out"
          description: "Zoomed out to show more of bridge structure"
        sky:
          color: "#87CEEB"
          cloud:
            position: "far-right"
            size: "small"
            color: "white"
        characters:
          - id: "char1"
            location: "climbed"
            position: "hanging-on-fence"
            positionDetail: "1 head down from fence top"
            emotion: "anguished"
            posture: "standing"
            expression: "eyebrows-down"
            size: "slightly-smaller-than-shot2"
            description: "SG appears slightly smaller than in shot 2"
            renderStyle:
              fillColor: "#FFE4B5"
              mouthAnimation: "o-shape-to-flat"
            climbedPosition:
              bodyLean: "right"
              leanDegrees: 30
              extended: "in"
              legBent: "left"
              clamping: "right"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "What future?! I have no future. I'm a phone rep survey guy! Everybody hates surveys. They hear me talk and want to die!"
            startTime: 35.0
            endTime: 45.0
            delivery: "shouting-bitter"
            tone: "anguished-bitter"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          yOffset: 50
          fontSize: "small"
          lineHeight: 16
          description: "Thinner single-line caption bar, positioned at y=50"
          text: "(shouts back) What future? I have no future..."

      - id: "shot9"
        number: 9
        name: "WM4_LogicPivot"
        timeRange:
          start: 46.0
          end: 52.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char2"
            name: "WM from-above"
            position: "standing-on-road"
            positionDetail: "mid-road, 3 arm-lengths from center"
            headSize: "XLARGE"
            emotion: "logical"
            posture: "standing"
            expression: "mouth-straight"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              headDiameter: 40
              footAngles: "sharp-angle"
              eyesMouth: "upper-head"
              neck: false
              body: false
              armLength: 45
              armAnimation: "flailing-asymmetric"
            animation:
              arms: "asymmetric"
              wavePattern: "diagonal-axis"
        dialogue:
          - speaker: "char2"
            text: "So change your job. You're not that stupid that you can't do anything else, right?"
            startTime: 45.0
            endTime: 51.0
            delivery: "shouting-measured"
            tone: "logical"
        captions:
          position: "bottom"
          text: "So change your job..."

      - id: "shot10"
        number: 10
        name: "SG_Contemplating"
        timeRange:
          start: 52.0
          end: 55.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
          zoom: "zoomed-out"
          description: "Zoomed out to show more of bridge structure"
        sky:
          color: "#87CEEB"
          description: "Bright light blue sky color"
          cloud:
            position: "far-right"
            size: "small"
            color: "white"
        characters:
          - id: "char1"
            location: "climbed"
            position: "hanging-on-fence"
            positionDetail: "1 head down from fence top"
            emotion: "contemplative"
            posture: "standing"
            expression: "mouth-tilde"
            eyebrows: "slanting"
            size: "slightly-smaller-than-shot2"
            description: "SG appears slightly smaller than in shot 2"
            renderStyle:
              fillColor: "#FFE4B5"
              mouthAnimation: "o-shape-to-flat"
            climbedPosition:
              bodyLean: "left"
              leanDegrees: 30
              extended: "in"
              legBent: "right"
              clamping: "left"
        dialogue: []
        captions:
          position: "bottom"
          text: ""

      - id: "shot11"
        number: 11
        name: "WM_OffersSurvey"
        timeRange:
          start: 55.0
          end: 61.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char2"
            name: "WM from-above"
            position: "standing-on-road"
            positionDetail: "mid-road, 3 arm-lengths from center"
            headSize: "XLARGE"
            emotion: "cunning"
            posture: "standing"
            expression: "eyebrows-down"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              headDiameter: 40
              footAngles: "sharp-angle"
              eyesMouth: "upper-head"
              neck: false
              body: false
              armLength: 45
              armAnimation: "flailing-asymmetric"
            animation:
              arms: "asymmetric"
              wavePattern: "diagonal-axis"
              expressionChange: "timed"
              changes:
                - time: 0.0
                  expression: "eyebrows-down"
                - time: 1.0
                  expression: "mouth-smile"
        dialogue:
          - speaker: "char2"
            text: "Before you step down, would you mind taking a short survey?"
            startTime: 55.0
            endTime: 60.0
            delivery: "clear-measured"
            tone: "dark-humor"
          - speaker: "char2"
            text: ""
            startTime: 60.0
            endTime: 61.0
            delivery: "pause"
            tone: "anticipation"
        captions:
          position: "bottom"
          text: "Before you step down, would you mind taking a short survey?"

      - id: "shot12"
        number: 12
        name: "Resolution"
        timeRange:
          start: 61.0
          end: 65.0
        camera:
          pov: "cut-to-black"
        characters: []
        dialogue: []
        captions:
          position: "center"
          text: "Splash!"
        narration:
          - speaker: "char3"
            voice: "voice3"
            text: "[pause] Splash! [pause]"
            startTime: 60.0
            endTime: 64.0
            delivery: "sound-effect"
            caption: "Splash!"
            pauseInstructions: "Pauses are instructions, not written or narrated"

