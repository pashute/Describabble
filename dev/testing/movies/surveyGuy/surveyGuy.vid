# surveyGuy.vid v0.1.53
# Standardized YAML format for Describabble stick figure animation
# Machine-readable and human-friendly structure

movie:
  name: "The Survey Guy"
  version: "0.1.9"
  created: "2025-09-14"
  description: "A dark comedy stick figure short film about a phone survey guy contemplating a bridge jump"
  license: "Unlicense (Free and Open Source)"
  creator: "Moussa Yashir"
  production: "Describabble with Anthropic Claude and Gemini Flash lite"

specs:
  totalDuration: 60.0
  fps: 60
  canvasWidth: 960
  canvasHeight: 540
  aspectRatio: "16:9"

describs:
  characters: "desc.surveyGuy.characters.md"
  scene1: "desc.surveyGuy.scene1.md"
  dialogue: "desc.surveyGuy.dialogue.map.md"
  locations: "desc.surveyGuy.locations.md"
  emotions: "trans.surveyGuy.emotions.md"
  component_bridge: "desc.surveyGuy.component.bridge.md"
  meta_emotions: "meta.stick.emotions.md"
  meta_movement: "meta.stick.movement.md"
  meta_component_bridge: "meta.stick.component.bridge.md"

meta:
  gen:
    captions:
      showSpeakerName: false
      audioFormat: "parentheses"
      description: "Caption generation rules: do not display speaker names, show audio descriptions in (parentheses)"

voices:
  voice1:
    id: "Male1"
    name: "Deep Male"
    pitch: "low"
    volume: 1.0
    narration: true
    description: "Deep, low-pitched male voice for narration and Survey Guy"
  voice2:
    id: "Male2"
    name: "Clear Male"
    pitch: "medium"
    volume: 1.0
    narration: false
    description: "Clear, medium-pitched male voice for Worried Man"
  voice3:
    id: "Male3"
    name: "Deep Narrator"
    pitch: "low"
    volume: 1.0
    narration: true
    description: "Deep, resonant male voice for narrator and sound effects"

characters:
  - id: "char1"
    name: "Survey Guy"
    aka: "SG"
    role: "protagonist"
    importance: 1
    headSize: "LARGE"
    headShape: "oval"
    headVariants: "hair-line"
    attire:
      shirt: "blue-long-sleeve"
      tie: "bent-diagonal"
    voice:
      gender: "male"
      age: "30s"
      quality: "slightly nasal"
    emotionArc:
      - timeRange: "0-4s"
        emotion: "distressed"
        posture: "climbing"
        details: "climbing hesitantly, panting"
      - timeRange: "4-14s"
        emotion: "defensive"
        posture: "standing-on-ledge"
        details: "responding sharply, denying family"
      - timeRange: "14-26s"
        emotion: "raw"
        posture: "standing-on-ledge"
        details: "becoming honest, voice cracks"
      - timeRange: "26-40s"
        emotion: "anguished"
        posture: "standing-on-ledge"
        details: "bitter complaint about job"
      - timeRange: "40-46s"
        emotion: "contemplative"
        posture: "standing-on-ledge"
        details: "processing Worried Man's logic"
      - timeRange: "46-53s"
        emotion: "accepting"
        posture: "standing-on-ledge"
        details: "resigned, considers offer"

  - id: "char2"
    name: "Worried Man"
    aka: "WM"
    role: "support"
    importance: 1
    headSize: "LONG"
    headShape: "oval-elongated"
    headVariants: "none"
    attire:
      shirt: "casual"
      tie: "none"
    voice:
      gender: "male"
      age: "24"
      quality: "clear, direct, urgent"
    emotionArc:
      - timeRange: "9-14s"
        emotion: "worried"
        posture: "standing"
        details: "first plea about wife/children"
      - timeRange: "19-23s"
        emotion: "desperate"
        posture: "standing"
        details: "escalating second plea"
      - timeRange: "26-30s"
        emotion: "desperate"
        posture: "standing"
        details: "third plea, peak desperation"
      - timeRange: "40-46s"
        emotion: "logical"
        posture: "standing"
        details: "practical advice, reasoning pivot"
      - timeRange: "46-51s"
        emotion: "cunning"
        posture: "standing"
        details: "punchline delivery with clarity"

  - id: "char3"
    name: "Narrator"
    aka: "NARRATOR"
    role: "narrator"
    importance: 0
    backstage: true
    headSize: "NONE"
    voice:
      gender: "male"
      age: "50s"
      quality: "deep, resonant, authoritative"
    description: "Off-screen narrator for sound effects and scene descriptions"

locations:
  - id: "loc_bridge_below"
    name: "River Below Bridge"
    camera:
      position: "riverside-ground"
      angle: "looking-up"
      target: "bridge-and-character"
    elements:
      - "suspension-bridge"
      - "fence-railing"
      - "suspender-cables"
    lighting: "daytime-overcast"
    description: "Looking up at bridge from riverside, seeing character climbing on fence"

  - id: "loc_bridge_top"
    name: "Bridge Top View"
    camera:
      position: "bridge-level"
      angle: "looking-down"
      target: "riverside"
    elements:
      - "suspension-bridge"
      - "river"
      - "distant-character"
    lighting: "daytime-overcast"
    description: "Standing on bridge looking down at riverside and distant character"

scenes:
  - id: "scene1"
    number: 1
    name: "EXT. SUSPENSION BRIDGE - DAY"
    duration:
      start: 0.0
      end: 53.0
    location: "loc_bridge"
    shots:
      - id: "shot1"
        number: 1
        name: "credits"
        timeRange:
          start: 0.0
          end: 8.0
        camera:
          pov: "credits-screen"
          angle: "centered"
        characters: []
        dialogue: []
        captions:
          text1:
            align: "left"
            lines: 10
            emptyRowMode: "keep"
            content: |
              The Survey Guy



              TTTTT H   H EEEEE   SSSS  U   U RRRRR V   V EEEEE Y   Y  GGGGG U   U Y   Y
                T   H   H E      S     U   U R   R V   V E      Y Y   G     U   U  Y Y
                T   HHHHH EEEEE   SSS  U   U RRRRR V   V EEEEE   Y    G  GG U   U   Y
                T   H   H E           S U   U R   R  V V  E       Y    G   G U   U   Y
                T   H   H EEEEE  SSSS  UUUUU R   R   V   EEEEE   Y    GGGGG UUUUU   Y
          text2:
            align: "center"
            lines: 9
            emptyRowMode: "keep"
            content: |

              Starring:
              Harold Purpleman as The Survey Guy
              Herman Herstick as The Worried Man

              Created and Edited by Moussa Yashir
              Produced by Describabble

              Released Unlicensed Sept 2026
        narration:
          - speaker: "char3"
            voice: "voice3"
            text: "The Survey Guy"
            startTime: 0.0
            endTime: 1.0
            delivery: "title-reading"
          - speaker: "char3"
            voice: "voice3"
            text: "(Heavy traffic heard)"
            startTime: 2.0
            endTime: 3.0
            delivery: "sound-effect"
            caption: "(Heavy traffic heard)"

      - id: "shot2"
        number: 2
        name: "climbing"
        timeRange:
          start: 8.0
          end: 13.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
        characters:
          - id: "char1"
            location: "new"
            position: "fence-climbing"
            emotion: "distressed"
            posture: "climbing"
            details: "panting, hesitant motion"
        movement:
          character: "char1"
          type: "climbing"
          description: "climbing up fence from bridge, hands gripping, legs bent"
          keyframes:
            - time: 0.0
              position: "fence-bottom"
            - time: 4.0
              position: "fence-top"
        dialogue: []
        captions:
          position: "bottom"
          text: "EXT. SUSPENSION BRIDGE - DAY"
        narration:
          voice: "voice1"
          caption: "(Heavy traffic heard)"
          text: "(Heavy traffic heard)"

      - id: "shot3"
        number: 3
        name: "WM1_Wife"
        timeRange:
          start: 13.0
          end: 19.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Tree top partially covering road on grass-right side. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence-top"
            emotion: "defensive"
            posture: "standing"
            postClimb: true
          - id: "char2"
            position: "standing-on-road"
            headSize: "XLARGE"
            emotion: "worried"
            posture: "standing"
            expression: "eyebrows-up"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              bodyHeight: "short"
              headDiameter: 20
              handLength: 20
              armAnimation: "flailing-extended"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Think about your wife! Think about your children!"
            startTime: 13.0
            endTime: 18.0
            delivery: "shouting-urgent"
            tone: "emotional"
            voiceCue: "(shouts)"
        captions:
          position: "bottom"
          text: "(shouts) Think about your wife! Think about your children!"

      - id: "shot4"
        number: 4
        name: "SG1_NoWife"
        timeRange:
          start: 19.0
          end: 24.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "defensive"
            posture: "standing"
            expression: "eyebrows-down"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "I don't have a wife! I don't have kids!"
            startTime: 18.0
            endTime: 23.0
            delivery: "shouting-defensive"
            tone: "emphatic"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          text: "(shouts back) I don't have a wife! I don't have kids!"

      - id: "shot5"
        number: 5
        name: "WM2_Parents"
        timeRange:
          start: 24.0
          end: 28.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Tree top partially covering road on grass-right side. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "defensive"
            posture: "standing"
          - id: "char2"
            position: "standing-on-road"
            headSize: "XLARGE"
            emotion: "desperate"
            posture: "standing"
            expression: "eyebrows-down"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              bodyHeight: "short"
              headDiameter: 20
              handLength: 20
              armAnimation: "flailing-extended"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Think about your parents!"
            startTime: 24.0
            endTime: 28.0
            delivery: "shouting-desperate"
            tone: "escalating"
            voiceCue: "(shouts)"
        captions:
          position: "bottom"
          text: "(shouts) Think about your parents!"

      - id: "shot6"
        number: 6
        name: "SG2_NoParents"
        timeRange:
          start: 28.0
          end: 31.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "anguished"
            posture: "standing"
            expression: "mouth-open"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "I don't have parents!"
            startTime: 28.0
            endTime: 31.0
            delivery: "shouting-raw"
            tone: "emotional"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          text: "(shouts back) I don't have parents!"

      - id: "shot7"
        number: 7
        name: "WM3_Future"
        timeRange:
          start: 31.0
          end: 35.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Tree top partially covering road on grass-right side. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "anguished"
            posture: "standing"
          - id: "char2"
            position: "standing-on-road"
            headSize: "XLARGE"
            emotion: "desperate"
            posture: "standing"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              bodyHeight: "short"
              headDiameter: 20
              handLength: 20
              armAnimation: "flailing-extended"
        dialogue:
          - speaker: "char2"
            voice: "voice2"
            text: "Think about your future!"
            startTime: 31.0
            endTime: 35.0
            delivery: "shouting-peak"
            tone: "maximum-intensity"
            voiceCue: "(shouts)"
        captions:
          position: "bottom"
          text: "(shouts) Think about your future!"

      - id: "shot8"
        number: 8
        name: "SG3_NoFuture"
        timeRange:
          start: 35.0
          end: 45.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "anguished"
            posture: "standing"
            expression: "eyebrows-down"
        dialogue:
          - speaker: "char1"
            voice: "voice1"
            text: "What future?! I have no future. I'm a phone rep survey guy! Everybody hates surveys. They hear me talk and want to die!"
            startTime: 35.0
            endTime: 45.0
            delivery: "shouting-bitter"
            tone: "anguished-bitter"
            voiceCue: "(shouts back)"
        captions:
          position: "bottom"
          text: "(shouts back) What future? I have no future..."

      - id: "shot9"
        number: 9
        name: "WM4_LogicPivot"
        timeRange:
          start: 45.0
          end: 51.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Tree top partially covering road on grass-right side. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "contemplative"
            posture: "standing"
          - id: "char2"
            position: "standing-on-road"
            headSize: "XLARGE"
            emotion: "logical"
            posture: "standing"
            expression: "mouth-straight"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              bodyHeight: "short"
              headDiameter: 20
              handLength: 20
              armAnimation: "flailing-extended"
        dialogue:
          - speaker: "char2"
            text: "So change your job. You're not that stupid that you can't do anything else, right?"
            startTime: 45.0
            endTime: 51.0
            delivery: "shouting-measured"
            tone: "logical"
        captions:
          position: "bottom"
          text: "So change your job..."

      - id: "shot10"
        number: 10
        name: "SG_Contemplating"
        timeRange:
          start: 51.0
          end: 53.0
        camera:
          pov: "from-below"
          location: "loc_bridge_below"
          perspective: "looking-up-at-char1-on-fence"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "contemplative"
            posture: "standing"
            expression: "mouth-tilde"
            eyebrows: "slanting"
        dialogue: []
        captions:
          position: "bottom"
          text: ""

      - id: "shot11"
        number: 11
        name: "WM_OffersSurvey"
        timeRange:
          start: 53.0
          end: 59.0
        camera:
          pov: "from-bridge"
          location: "loc_bridge_top"
          perspective: "looking-down-at-char1-below"
          scale: 0.5
          environment:
            description: "From-bridge overhead view: Grass areas on both left and right sides. Vertical blue river running through center under bridge midpoint. Vertical gray road running alongside river on right side. Worried Man positioned on road looking upward at bridge. Tree top partially covering road on grass-right side. Silver bridge ridge at bottom of frame."
            layout:
              - element: "grass-left"
                position: "left-side"
                size: "quarter"
                color: "light-green"
              - element: "river"
                position: "center"
                size: "quarter"
                color: "light-blue"
              - element: "road"
                position: "right-of-river"
                size: "narrow"
                color: "gray"
              - element: "grass-right"
                position: "right-side"
                size: "remaining"
                color: "light-green"
              - element: "bridge"
                position: "bottom"
                orientation: "horizontal"
                color: "silver"
              - element: "tree"
                position: "grass-right-top"
                coverage: "partial-over-road"
                color: "dark-green"
                note: "NO TRUNK - foliage circle only"
        characters:
          - id: "char1"
            location: "continued"
            position: "standing-on-fence"
            emotion: "accepting"
            posture: "standing"
          - id: "char2"
            position: "standing-on-road"
            headSize: "XLARGE"
            emotion: "cunning"
            posture: "standing"
            expression: "mouth-smile"
            pov: "from-above"
            renderStyle:
              lineWidth: 6
              color: "#FFFFFF"
              bodyHeight: "short"
              headDiameter: 20
              handLength: 20
              armAnimation: "flailing-extended"
        dialogue:
          - speaker: "char2"
            text: "Before you step down, would you reply to a short survey?"
            startTime: 53.0
            endTime: 58.5
            delivery: "clear-measured"
            tone: "dark-humor"
        captions:
          position: "bottom"
          text: "Before you step down, would you reply to a short survey?"

      - id: "shot12"
        number: 12
        name: "Resolution"
        timeRange:
          start: 59.0
          end: 60.0
        camera:
          pov: "cut-to-black"
        characters: []
        dialogue: []
        captions:
          position: "none"
          text: ""
        narration:
          voice: "voice1"
          caption: "(splash!)"
          text: "(splash!)"

status:
  ready: true
  lastBuilt: "2026-09-15"
  buildTool: "stickmake v0.1.9"

notes:
  - "POV switches occur at speaker boundaries"
  - "Character never both visible simultaneously (alternating POVs)"
  - "Ending (splash) implies comedic resolution"
